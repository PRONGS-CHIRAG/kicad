# Copy this file to `backend/.env` and fill in what you need.
# `.env` is git-ignored. Every variable here can also be exported in the shell
# instead; the shell wins over the file.

# --- Devin agent (optional) --------------------------------------------------
# Paste your key here. Service-user keys start with `cog_`.
# Get one at: Devin settings -> Service users (or Enterprise settings).
# A bare DEVIN_API_KEY in the shell also works.
KICAD_MITOS_DEVIN_API_KEY=

# Turn the agent on. WITHOUT this, a key alone changes nothing: planning stays
# fully deterministic and an ambiguity is still put to you as a question.
# With it, a *resolvable* ambiguity is answered by a Devin session instead, and
# every answer is recorded as a visible assumption on the plan.
KICAD_MITOS_AUTO_RESOLVE=false

# Override for an enterprise tenant.
# KICAD_MITOS_DEVIN_BASE_URL=https://api.devin.ai/v1

# How long to wait for a session before giving up and asking you instead.
# A Devin session takes minutes, so this is a ceiling, not an expectation.
# KICAD_MITOS_DEVIN_TIMEOUT_SECONDS=120

# Poll interval while the session runs.
# KICAD_MITOS_DEVIN_POLL_SECONDS=5

# ACU ceiling per session, so one answer cannot run away with your budget.
# KICAD_MITOS_DEVIN_MAX_ACU=5

# --- OpenAI-compatible plan proposer (optional, separate from the above) ------
# Lets a chat model propose the whole action plan. Its plan is discarded if the
# validator rejects it. A bare OPENAI_API_KEY also works.
# KICAD_MITOS_OPENAI_API_KEY=

# --- Everything else has a working default -----------------------------------
# KICAD_MITOS_WORKSPACE=/tmp/kicad-mitos
# KICAD_MITOS_KICAD_CLI=kicad-cli
# KICAD_MITOS_EXECUTOR=local
# KICAD_MITOS_MITOS_COMMAND=python3 -m app.mcp_server
# KICAD_MITOS_CORS_ORIGINS=["http://localhost:3000"]
